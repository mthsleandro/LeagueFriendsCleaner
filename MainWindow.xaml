<Window x:Class="LOLFriendsCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoL Friends Cleaner — por Matheus Leandro"
        Width="980" Height="780" MinWidth="780" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Icon="/Assets/icon.ico" UseLayoutRounding="True"
        SourceInitialized="Window_SourceInitialized" Loaded="Window_Loaded">
    <Grid>

        <Grid Margin="28,22,28,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Source="/Assets/icon.png" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality"/>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="LoL Friends Cleaner" FontSize="23" FontWeight="Bold"/>
                    <TextBlock Margin="0,3,0,0" FontSize="12.5" Foreground="{StaticResource TextDimBrush}">
                        <Run Text="Limpe sua lista de amigos escolhendo quem sai e quem fica. "/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="16" Padding="13,7" Background="{StaticResource Surface2Brush}"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="ReloadButton" Content="↻  Recarregar" Margin="10,0,0,0"
                            Style="{StaticResource GhostButton}" Padding="14,8" Click="Reload_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid>
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBoxStyle}" TextChanged="SearchBox_TextChanged"/>

                    <Canvas Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="16,0,0,0" IsHitTestVisible="False">
                        <Ellipse Width="12" Height="12" Canvas.Left="2" Canvas.Top="2"
                                 Stroke="{StaticResource TextFaintBrush}" StrokeThickness="2"/>
                        <Line X1="12" Y1="12" X2="18" Y2="18" Stroke="{StaticResource TextFaintBrush}"
                              StrokeThickness="2" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                    </Canvas>

                    <TextBlock Text="Pesquisar por nome ou tag…"
                               IsHitTestVisible="False" Margin="46,0,40,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" FontSize="13.5"
                               Foreground="{StaticResource TextFaintBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                            ToolTip="Limpar pesquisa" Click="ClearSearch_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <Button x:Name="MarkButton" Grid.Column="1" Margin="10,0,0,0" Padding="16,0"
                        Style="{StaticResource GhostButton}" Click="Mark_Click"/>
                <Button x:Name="UnmarkButton" Grid.Column="2" Margin="8,0,0,0" Padding="16,0"
                        Style="{StaticResource GhostButton}" Click="Unmark_Click"/>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="14"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="22,14,22,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ShowingText" FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                        <TextBlock x:Name="CounterText" Grid.Column="1" FontSize="12" FontWeight="SemiBold"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="10,0,6,10">
                        <ListBox x:Name="FriendsList" Background="Transparent" BorderThickness="0"
                                 Padding="0,0,4,0"
                                 ItemContainerStyle="{StaticResource FriendItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 Visibility="Collapsed">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
                            </ListBox.Resources>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource RowCheck}" IsChecked="{Binding ToDelete, Mode=TwoWay}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid Width="38" Height="38">
                                                <Ellipse Fill="{StaticResource Surface3Brush}"/>
                                                <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" FontWeight="SemiBold" FontSize="15"/>
                                                <Ellipse Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                         Margin="0,0,-3,-3" Fill="{Binding StatusBrush}"
                                                         Stroke="{StaticResource SurfaceBrush}" StrokeThickness="2.5"/>
                                            </Grid>

                                            <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                                                <TextBlock TextTrimming="CharacterEllipsis" FontSize="14">
                                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding TagText, Mode=OneWay}" Foreground="{StaticResource TextDimBrush}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding StatusLine}" FontSize="11.5" Margin="0,2,0,0"
                                                           Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <Border Grid.Column="2" CornerRadius="6" Padding="9,4" VerticalAlignment="Center" MinWidth="68">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ToDelete}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="MANTER"/>
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ToDelete}" Value="True">
                                                                    <Setter Property="Text" Value="EXCLUIR"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Conectando ao cliente do League of Legends…" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center">
                                <TextBlock.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.9"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </TextBlock.Triggers>
                            </TextBlock>
                            <TextBlock Text="Mantenha o cliente aberto e com login feito." Margin="0,6,0,0" FontSize="12.5"
                                       Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel x:Name="DisconnectedPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    MaxWidth="460" Visibility="Collapsed">
                            <TextBlock Text="Cliente não encontrado" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="DisconnectedMessage" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"
                                       LineHeight="20" Foreground="{StaticResource TextDimBrush}"/>
                            <Button Content="Tentar novamente" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"
                                    HorizontalAlignment="Center" Padding="22,10" Click="Reload_Click"/>
                        </StackPanel>

                        <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="Sua lista de amigos está vazia" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Não há nada para limpar por aqui." Margin="0,8,0,0"
                                       Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel x:Name="NoResultsPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="Nenhum amigo encontrado" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Tente outro nome ou limpe a pesquisa." Margin="0,8,0,0"
                                       Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SummaryText" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SummaryHint" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource TextDimBrush}"/>
                </StackPanel>
                <Button x:Name="DeleteButton" Grid.Column="1" Style="{StaticResource DangerButton}"
                        Padding="26,13" FontSize="14" Margin="16,0,0,0" Click="Delete_Click"/>
            </Grid>

            <!-- ============ Letras miúdas + autoria ============ -->
            <Border Grid.Row="4" Margin="0,16,0,0" Padding="0,12,0,0"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="10.5" LineHeight="15"
                               Foreground="{StaticResource TextFaintBrush}">
                        <Run Text="AVISO: " FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                        <Run Text="Este é um aplicativo independente e não oficial. Ele não é endossado pela Riot Games e não reflete as opiniões da Riot Games nem de quem produz ou gerencia o League of Legends. League of Legends e Riot Games são marcas registradas da Riot Games, Inc. O app usa a API local do cliente (LCU), cujo uso por terceiros não é oficialmente garantido pela Riot. Embora ele tenha algumas proteções (pausas entre as remoções, interrupção após falhas seguidas, confirmação e cancelamento a qualquer momento), "/><Run Text="NÃO NOS RESPONSABILIZAMOS POR EVENTUAIS BANIMENTOS, SUSPENSÕES OU OUTROS PROBLEMAS NA SUA CONTA. USE POR SUA CONTA E RISCO." FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                    </TextBlock>
                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextDimBrush}">
                            <Run Text="Criado por "/><Run Text="Matheus Leandro" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}"/><Run x:Name="VersionRun" Text=" · v1.0.0"/>
                        </TextBlock>
                        <Button Grid.Column="1" Content="Entenda os riscos e como o app funciona"
                                Style="{StaticResource LinkButton}" Click="Risks_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="DimLayer" Background="#B3000000" Visibility="Collapsed" Panel.ZIndex="10"/>

        <Grid x:Name="ProgressLayer" Background="#CC000000" Visibility="Collapsed" Panel.ZIndex="11">
            <Border Width="480" CornerRadius="16" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.65" Color="Black"/>
                </Border.Effect>
                <StackPanel Margin="28,26,28,24">
                    <TextBlock Text="Removendo amigos…" FontSize="19" FontWeight="Bold"/>
                    <TextBlock x:Name="ProgressName" Margin="0,14,0,0" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar x:Name="ProgressBarMain" Style="{StaticResource SlimProgress}" Margin="0,12,0,0"/>
                    <Grid Margin="0,10,0,0">
                        <TextBlock x:Name="ProgressCount" FontSize="12.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ProgressEta" FontSize="12.5" HorizontalAlignment="Right"
                                   Foreground="{StaticResource TextDimBrush}"/>
                    </Grid>
                    <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" FontSize="12" LineHeight="18"
                               Foreground="{StaticResource TextDimBrush}"
                               Text="Há pausas propositais entre as remoções para respeitar os limites do cliente. Não feche o League of Legends nem este aplicativo até terminar."/>
                    <Button x:Name="CancelButton" Content="Cancelar" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Right" Margin="0,20,0,0" MinWidth="110" Click="Cancel_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
