<Window x:Class="LOLFriendsCleaner.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="540" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" PreviewKeyDown="Window_PreviewKeyDown">
    <Border x:Name="Card" Margin="24" CornerRadius="16"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.65" Color="Black"/>
        </Border.Effect>
        <StackPanel Margin="28,26,28,24">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="40" Height="40" VerticalAlignment="Top">
                    <Ellipse x:Name="IconCircle" Opacity="0.18"/>
                    <TextBlock x:Name="IconGlyph" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="20" FontWeight="Bold"/>
                </Grid>
                <TextBlock x:Name="TitleText" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"
                           FontSize="19" FontWeight="Bold" TextWrapping="Wrap"/>
            </Grid>

            <TextBlock x:Name="MessageText" Margin="0,18,0,0" TextWrapping="Wrap" LineHeight="20"
                       FontSize="13.5"/>

            <Border x:Name="WarningBox" Margin="0,16,0,0" Padding="14,11" CornerRadius="10" BorderThickness="1"
                    Visibility="Collapsed">
                <TextBlock x:Name="WarningText" TextWrapping="Wrap" LineHeight="19" FontSize="12.5" FontWeight="SemiBold"/>
            </Border>

            <TextBlock x:Name="DetailText" Margin="0,14,0,0" TextWrapping="Wrap" LineHeight="18" FontSize="12"
                       Foreground="{StaticResource TextDimBrush}" Visibility="Collapsed"/>

            <CheckBox x:Name="ConfirmCheck" Margin="0,18,0,0" Style="{StaticResource PlainCheck}" Visibility="Collapsed">
                <TextBlock x:Name="ConfirmCheckText" TextWrapping="Wrap" FontSize="12.5" LineHeight="18"/>
            </CheckBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="SecondaryButton" Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                        MinWidth="104" Click="Secondary_Click"/>
                <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" MinWidth="128" Click="Primary_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
