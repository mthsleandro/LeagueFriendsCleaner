<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Identidade / autoria -->
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Product>LoL Friends Cleaner</Product>
    <Authors>Matheus Leandro</Authors>
    <Company>Matheus Leandro</Company>
    <Copyright>© 2026 Matheus Leandro</Copyright>
    <Description>Limpe sua lista de amigos do League of Legends escolhendo quem sai e quem fica. Criado por Matheus Leandro.</Description>
    <Version>1.0.0</Version>

    <!-- Publicação em um único .exe (usado pelo GitHub Actions) -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PoniLCU" Version="1.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\icon.png" />
  </ItemGroup>

</Project>
